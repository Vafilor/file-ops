            "args": ["uqname", "path"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Index",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/file_ops/cli.py",
