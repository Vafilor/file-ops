        },
        {
            "name": "Hash",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/file_ops/cli.py",
            "args": ["hash"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Watch",
            "type": "debugpy",
